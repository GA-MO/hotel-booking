# Environment
ENV=development
LOG_LEVEL=debug

# API server
API_PORT=8080
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Postgres
DATABASE_URL=postgres://hotel:hotel@localhost:5432/hotel_booking?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage (MinIO locally)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=hotel-booking
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/hotel-booking

# Image proxy
IMGPROXY_BASE_URL=http://localhost:8081
IMGPROXY_KEY=
IMGPROXY_SALT=

# JWT / auth
JWT_SECRET=change-me-in-production-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Subscription billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OMISE_SECRET_KEY=
OMISE_PUBLIC_KEY=

# Frontend public env
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_BOOKING_BASE_URL=http://localhost:3000
