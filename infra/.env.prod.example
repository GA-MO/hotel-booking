# ============================================================================
# Production env template
# ============================================================================
# Copy to .env.prod at the REPO ROOT on the production server, then fill in.
# Lock the file down:  chmod 600 .env.prod  (and chown to the deploy user)
#
# Legend:
#   [required]  must be set or the stack will refuse to start / will be insecure
#   [optional]  has a sensible default or only needed for that integration
# ============================================================================

# ---- Public domain (used by Caddy + frontend public URLs) ------------------
# [required] Base apex domain. Caddy will serve api.${DOMAIN}, book.${DOMAIN},
# admin.${DOMAIN}, img.${DOMAIN}. DNS records must already exist in Cloudflare.
DOMAIN=example.com

# [optional] Used by Let's Encrypt for renewal-failure emails. Defaults to
# admin@${DOMAIN} if not set.
ACME_EMAIL=admin@example.com

# ---- App env ---------------------------------------------------------------
# [required]
ENV=production
LOG_LEVEL=info

# ---- API server ------------------------------------------------------------
# [required]
API_PORT=8080
# Comma-separated CORS allowlist. Must match the public Next.js origins.
API_CORS_ORIGINS=https://book.example.com,https://admin.example.com

# ---- Postgres --------------------------------------------------------------
# [required] These three are read by the `postgres` service at boot.
POSTGRES_USER=hotel
POSTGRES_PASSWORD=replace-with-a-long-random-string
POSTGRES_DB=hotel_booking

# [required] DB URL the api/worker use to connect. Host is `postgres` (the
# docker service name). sslmode=disable is fine since traffic stays on the
# internal docker network.
DATABASE_URL=postgres://hotel:replace-with-a-long-random-string@postgres:5432/hotel_booking?sslmode=disable

# ---- Redis -----------------------------------------------------------------
# [required]
REDIS_URL=redis://redis:6379/0

# ---- Object storage (MinIO, in-cluster) ------------------------------------
# [required] Read by the `minio` service at boot and by api/imgproxy.
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-string

# [required] What the api uses to talk to MinIO.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minio-admin
STORAGE_SECRET_KEY=replace-with-a-long-random-string
STORAGE_BUCKET=hotel-booking
# Public URL prefix browsers see — typically via imgproxy or a CDN rewrite.
STORAGE_PUBLIC_BASE_URL=https://img.example.com

# ---- Image proxy -----------------------------------------------------------
# [required] Public base URL of imgproxy (served by Caddy at img.${DOMAIN}).
IMGPROXY_BASE_URL=https://img.example.com
# [optional but recommended in prod] Signed URL key+salt. Hex-encoded, 32 bytes
# each.  Generate:  openssl rand -hex 32
IMGPROXY_KEY=
IMGPROXY_SALT=

# ---- JWT / auth ------------------------------------------------------------
# [required] Generate:  openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ---- Email (Resend) --------------------------------------------------------
# [optional — required for booking confirmations / dunning emails]
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# ---- LINE Messaging API ----------------------------------------------------
# [optional — required for LINE notifications]
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ---- Subscription billing (Stripe + Omise) ---------------------------------
# [optional — required once Phase 3 subscription billing goes live]
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OMISE_SECRET_KEY=
OMISE_PUBLIC_KEY=

# ---- Frontend public env ---------------------------------------------------
# [required] These are baked into the Next.js bundles at build time, so the
# images must be rebuilt if you change them.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_BOOKING_BASE_URL=https://book.example.com

# ---- Image tag / registry --------------------------------------------------
# [optional] Used by docker-compose.prod.yml to pull from GHCR. The deploy
# workflow sets IMAGE_TAG=<sha>. Leave default for build-from-source.
GHCR_OWNER=your-github-org-or-user
IMAGE_TAG=latest
